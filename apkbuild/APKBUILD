# APKBUILD for justplugins (test build)
#
# Non-conflicting test package: installs a modified phosh binary
# alongside the system phosh. Depends on phosh for schemas,
# plugins, and runtime dependencies.
#
# Usage:
#   abuild -r                           # build the .apk
#   sudo apk add justplugins            # install (no conflict with phosh)
#   sudo systemctl --user stop phosh     # stop system phosh
#   phosh-justplugins                    # run test build
#   # ... test the plugin manager ...
#   sudo systemctl --user start phosh   # restore system phosh

pkgname=justplugins
pkgver=0.1.0
pkgrel=0
_overlayver=0.1.0
_phoshver=0.57.0
pkgdesc="Phosh plugin manager - test binary for development"
arch="all !armhf"
url="https://github.com/cynosure279/JustPlugins"
license="GPL-3.0-or-later"
options="!check"

# Depends on system phosh: provides GSettings schemas, plugin dir,
# GIO extension points, and all runtime deps. NO conflict.
depends="phosh"

# Build dependencies (same as Alpine phosh package)
makedepends="
	callaudiod-dev
	elogind-dev
	evince-dev
	evolution-data-server-dev
	feedbackd-dev
	gcr-dev
	gettext-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gtk+3.0-dev
	libadwaita-dev
	libgudev-dev
	libhandy1-dev
	libsecret-dev
	linux-pam-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-elogind-dev
	pulseaudio-dev
	py3-docutils
	qrcodegen-dev
	upower-dev
	wayland-dev
	wayland-protocols
	"

# Sources:
#   1. Phosh release tarball
#   2. JustPlugins overlay tarball (our modifications)
source="https://sources.phosh.mobi/releases/phosh/phosh-$_phoshver.tar.xz
	justplugins-overlay-$_overlayver.tar.gz::https://github.com/cynosure279/JustPlugins/releases/download/v$_overlayver/justplugins-overlay-$_overlayver.tar.gz
	"
builddir="$srcdir/phosh-$_phoshver"

sha512sums="
51219a3295b061047765368a0f65a02b131c4b229ec03713f547595b73a98c51b99086769bf0584dd7d44b8426b21d50162e76e955fb7a37a5136cefa253fea8  phosh-0.57.0.tar.xz
d8d510a144638acfb49d5d8bc3de39dbae6c5216c9995bc1d273281e7aa894bbed1d80366b754b58d281d95f25f1eecfbbed9bd9a5bd38e6b352c037c42a63c8  justplugins-overlay-0.1.0.tar.gz
	"

prepare() {
	default_prepare

	local overlay_dir="$srcdir/justplugins-overlay-$_overlayver"

	if [ -d "$overlay_dir/src" ]; then
		msg "Applying JustPlugins overlay..."
		cp -f "$overlay_dir"/src/*.c "$builddir/src/"
		cp -f "$overlay_dir"/src/*.h "$builddir/src/"
		cp -f "$overlay_dir"/src/meson.build "$builddir/src/meson.build"
		cp -f "$overlay_dir"/src/phosh.gresources.xml "$builddir/src/phosh.gresources.xml"
		cp -f "$overlay_dir"/src/ui/*.ui "$builddir/src/ui/" 2>/dev/null || true
		msg "Overlay applied successfully"
	else
		error "JustPlugins overlay not found at $overlay_dir"
		return 1
	fi
}

build() {
	# Build phosh with our modifications
	# Standard prefix so PHOSH_PLUGINS_DIR = /usr/lib/phosh/plugins
	# (same as system phosh — reuses existing plugins)
	abuild-meson \
		-Db_lto=true \
		-Dphoc_tests=disabled \
		-Dman=false \
		-Dbindings-lib=false \
		-Dtools=true \
		-Dtests=false \
		-Dgtk_doc=false \
		-Dintrospection=false \
		. output
	meson compile -C output
}

package() {
	# Install ONLY the modified binary and library to a private location.
	# Does NOT touch /usr/bin/phosh or /usr/lib/libphosh-*.so
	# so there is zero conflict with the system phosh package.

	install -d "$pkgdir"/usr/lib/justplugins/bin
	install -d "$pkgdir"/usr/lib/justplugins/lib

	# Copy the modified phosh binary
	cp output/src/phosh "$pkgdir"/usr/lib/justplugins/bin/phosh-justplugins

	# Copy the modified libphosh shared library (contains plugin manager code)
	cp output/src/libphosh-*.so* "$pkgdir"/usr/lib/justplugins/lib/ 2>/dev/null || true

	# Create wrapper script at /usr/bin/phosh-justplugins
	install -d "$pkgdir"/usr/bin
	cat > "$pkgdir"/usr/bin/phosh-justplugins << 'WRAPPER'
#!/bin/sh
# phosh-justplugins — run the JustPlugins test build of phosh
# Sets LD_LIBRARY_PATH so the binary loads our modified libphosh
# (which contains the plugin manager code) instead of the system one.
export LD_LIBRARY_PATH="/usr/lib/justplugins/lib:$LD_LIBRARY_PATH"
exec /usr/lib/justplugins/bin/phosh-justplugins "$@"
WRAPPER
	chmod +x "$pkgdir"/usr/bin/phosh-justplugins
}
