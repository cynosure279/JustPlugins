# APKBUILD for phosh-justplugins
# Build Phosh with the JustPlugins plugin manager overlay
# Compatible with Alpine Linux and postmarketOS

# Maintainer: JustPlugins Contributors
pkgname=phosh-justplugins
pkgver=0.57.0
pkgrel=0
_overlayver=0.1.0
pkgdesc="Wayland shell for GNOME on mobile devices - with plugin manager"
# armhf: blocked by gnome-shell-schemas
arch="all !armhf"
url="https://github.com/cynosure279/JustPlugins"
license="GPL-3.0-or-later"
options="!check"  # tests need a running Wayland compositor

# This package replaces phosh
provides="phosh=$pkgver-r$pkgrel"
provider_priority=10
conflicts="phosh"

# Runtime dependencies (same as Alpine phosh package)
depends="
	adwaita-icon-theme
	bash
	dbus:org.freedesktop.Secrets
	desktop-file-utils
	gnome-control-center
	gnome-session
	gnome-settings-daemon
	gnome-shell-schemas
	gsettings-desktop-schemas
	phoc
	polkit-elogind
	xwayland
	"

# Build dependencies (same as Alpine phosh package)
makedepends="
	callaudiod-dev
	elogind-dev
	evince-dev
	evolution-data-server-dev
	feedbackd-dev
	gcr-dev
	gettext-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gtk+3.0-dev
	libadwaita-dev
	libgudev-dev
	libhandy1-dev
	libsecret-dev
	linux-pam-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-elogind-dev
	pulseaudio-dev
	py3-docutils
	qrcodegen-dev
	upower-dev
	wayland-dev
	wayland-protocols
	"

# Sources:
#   1. Phosh release tarball
#   2. JustPlugins overlay tarball (our modifications)
source="https://sources.phosh.mobi/releases/phosh/phosh-${pkgver/_/.}.tar.xz
	justplugins-overlay-$_overlayver.tar.gz::https://github.com/cynosure279/JustPlugins/releases/download/v$_overlayver/justplugins-overlay-$_overlayver.tar.gz
	"
builddir="$srcdir/phosh-${pkgver/_/.}"

# Phosh release tarball checksum (from Alpine aports)
# Overlay checksum will be filled by make-overlay.sh
sha512sums="
51219a3295b061047765368a0f65a02b131c4b229ec03713f547595b73a98c51b99086769bf0584dd7d44b8426b21d50162e76e955fb7a37a5136cefa253fea8  phosh-0.57.0.tar.xz
d8d510a144638acfb49d5d8bc3de39dbae6c5216c9995bc1d273281e7aa894bbed1d80366b754b58d281d95f25f1eecfbbed9bd9a5bd38e6b352c037c42a63c8  justplugins-overlay-0.1.0.tar.gz
	"

prepare() {
	default_prepare

	# Apply the JustPlugins overlay: copy our files over the phosh source
	local overlay_dir="$srcdir/justplugins-overlay-$_overlayver"

	if [ -d "$overlay_dir/src" ]; then
		msg "Applying JustPlugins overlay..."
		cp -f "$overlay_dir"/src/*.c "$builddir/src/"
		cp -f "$overlay_dir"/src/*.h "$builddir/src/"
		cp -f "$overlay_dir"/src/meson.build "$builddir/src/meson.build"
		cp -f "$overlay_dir"/src/phosh.gresources.xml "$builddir/src/phosh.gresources.xml"
		cp -f "$overlay_dir"/src/ui/*.ui "$builddir/src/ui/" 2>/dev/null || true
		msg "Overlay applied successfully"
		ls -la "$builddir"/src/plugin-*
	else
		error "JustPlugins overlay not found at $overlay_dir"
		return 1
	fi
}

build() {
	# Build phosh with our modifications using meson
	abuild-meson \
		-Db_lto=true \
		-Dphoc_tests=disabled \
		-Dman=true \
		-Dbindings-lib=true \
		-Dtools=true \
		-Dtests=false \
		-Dgtk_doc=false \
		-Dintrospection=false \
		. output
	meson compile -C output
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild --skip-subprojects -C output
}

# Subpackages - same structure as Alpine phosh
subpackages="
	libphosh:libs
	libphosh-dev:libphosh_dev
	$pkgname-dbg
	$pkgname-dev
	$pkgname-doc
	$pkgname-lang
	$pkgname-schemas::noarch
	$pkgname-systemd
	"

libphosh_dev() {
	amove usr/include/libphosh-*
	amove usr/lib/libphosh-*.so
	amove usr/lib/pkgconfig/libphosh-*.pc
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=

	amove usr/share/glib-2.0/schemas
}
