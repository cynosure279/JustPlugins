prepare() {
	default_prepare
	# Copy JustPlugins overlay (new source files) into phosh source tree
	cp -v "$srcdir"/src/plugin-info.c "$builddir"/src/
	cp -v "$srcdir"/src/plugin-info.h "$builddir"/src/
	cp -v "$srcdir"/src/plugin-manager.c "$builddir"/src/
	cp -v "$srcdir"/src/plugin-manager.h "$builddir"/src/
	cp -v "$srcdir"/src/plugin-manager-page.c "$builddir"/src/
	cp -v "$srcdir"/src/plugin-manager-page.h "$builddir"/src/
	cp -v "$srcdir"/src/ui/plugin-manager-page.ui "$builddir"/src/ui/
}

build() {
	# phoc tests need a running Wayland compositor
	abuild-meson 		-Db_lto=true 		-Dphoc_tests=disabled 		-Dman=true 		-Dtests=false 		-Dgtk_doc=false 		-Dintrospection=false 		. output
	meson compile -C output
}

check() {
	# Skip tests (disabled above)
	:
}

package() {
	DESTDIR="$pkgdir/" meson install --no-rebuild --skip-subprojects -C output
}

schemas() {
	pkgdesc="$pkgdesc (schemas)"
	depends=
	amove usr/share/glib-2.0/schemas
}
