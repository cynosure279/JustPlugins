# Maintainer: JustPlugins Contributors
# Contributor: Cynosure <cynosure279@users.noreply.github.com>
#
# This is an overlay package that builds Phosh with the JustPlugins
# plugin manager feature. It replaces the stock phosh package.
#
# Build:  abuild -r
# Install: apk add phosh-justplugins

maintainer="JustPlugins Contributors <cynosure279@users.noreply.github.com>"
pkgname=phosh-justplugins
pkgver=0.57.0
pkgrel=0
pkgdesc="Wayland shell for GNOME on mobile devices (with JustPlugins plugin manager)"
# armhf: blocked by gnome-shell-schemas
arch="all !armhf"
url="https://github.com/cynosure279/JustPlugins"
license="GPL-3.0-only"
provides="phosh=$pkgver"
conflicts="phosh"

# Same runtime deps as stock phosh
depends="
	$pkgname-schemas
	adwaita-icon-theme
	dbus:org.freedesktop.Secrets
	desktop-file-utils
	gnome-shell-schemas
	gsettings-desktop-schemas
	phoc
	polkit-elogind
	"
makedepends="
	callaudiod-dev
	elogind-dev
	evince-dev
	evolution-data-server-dev
	feedbackd-dev
	gcr-dev
	gettext-dev
	glib-dev
	gmobile-dev
	gnome-bluetooth-dev
	gnome-desktop-dev
	gtk+3.0-dev
	libadwaita-dev
	libgudev-dev
	libhandy1-dev
	libsecret-dev
	linux-pam-dev
	meson
	modemmanager-dev
	networkmanager-dev
	polkit-elogind-dev
	pulseaudio-dev
	py3-docutils
	qrcodegen-dev
	upower-dev
	wayland-dev
	wayland-protocols
	"

subpackages="
	$pkgname-dbg
	$pkgname-dev
	$pkgname-lang
	$pkgname-schemas::noarch
	"

# Source 1: phosh release tarball
# Source 2: JustPlugins overlay (new source files)
# Sources 3+: patches for modified phosh files
source="https://sources.phosh.mobi/releases/phosh/phosh-0.57.0.tar.xz
	justplugins-overlay.tar.gz
	modify-quick-settings.c.patch
	modify-quick-settings.ui.patch
	modify-meson.build.patch
	modify-phosh.gresources.xml.patch
	"
builddir="$srcdir/phosh-0.57.0"

# sha512sums will be filled by 'abuild checksum'
sha512sums="
