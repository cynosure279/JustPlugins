8b5c2d385f3e444be35a1e3e41af1769484ad598b7c869e85edc4ad856c39822032c63082fd36edb95fd1e90286e3f438b15f24d17c6814a78095cb8b488d695  justplugins-overlay.tar.gz
186f41a6b8036cb23488792e1b4ad9eefc7f79feae807539da4961080cbcac784b514f570a9da8534c42e906585c272c3d5965bbcd008230fd51d59ae33af55b  modify-meson.build.patch
683642a35115768c3063d9ee1f481c1e197a5e634bd4d791da82b38cda47551217ac88b90798975534133155b072ccbf3ea8804310cb8148590594c5db7f28a4  modify-phosh.gresources.xml.patch
4ac4611e78dd827e0d54a993435029132a24a291a346e97f22646ff043a4bf0fd732ef5f6e5032eb54eea7e5720574f489bceec9c64c39fb548d414029a46ea9  modify-quick-settings.c.patch
